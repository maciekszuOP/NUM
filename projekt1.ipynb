    "import time\n",
    "import torch\n",
    "import numpy as np\n",
    "\n",
    "def measure_inference_time(model, test_dataloader, device=\"cuda\", num_warmup=10, num_measurements=100):\n",
    "    \"\"\"\n",
    "    Funkcja mierząca czas predykcji modelu zgodnie z wytycznymi z zadania.\n",
    "    \"\"\"\n",
    "    model = model.to(device)\n",
    "    model.eval()  # Wyłączamy Dropout i BatchNorm\n",
    "\n",
    "    # Pobieramy jedną paczkę danych (batch) z dataloadera, \n",
    "    # żeby testować na tych samych wymiarach wejścia.\n",
    "    dataiter = iter(test_dataloader)\n",
    "    images, _ = next(dataiter)\n",
    "    images = images.to(device)\n",
    "    \n",
    "    times = []\n",
    "\n",
    "    # Blokujemy liczenie gradientów (oszczędza pamięć i czas)\n",
    "    with torch.no_grad():\n",
    "        # 1. ROZGRZEWKA (Warm-up)\n",
    "        # Pierwsze zapytania są zawsze wolniejsze (alokacja pamięci, inicjalizacja kerneli CUDA).\n",
    "        for _ in range(num_warmup):\n",
    "            _ = model(images)\n",
    "            \n",
    "        # Synchronizujemy GPU, żeby mieć pewność, że rozgrzewka się skończyła\n",
    "        if device == \"cuda\":\n",
    "            torch.cuda.synchronize()\n",
    "            \n",
    "        # 2. WŁAŚCIWY POMIAR\n",
    "        for _ in range(num_measurements):\n",
    "            # Start stopera\n",
    "            start_time = time.perf_counter()\n",
    "            \n",
    "            # Forward pass\n",
    "            _ = model(images)\n",
    "            \n",
    "            # Zatrzymujemy stoper DOPIERO jak GPU skończy liczyć\n",
    "            if device == \"cuda\":\n",
    "                torch.cuda.synchronize()\n",
    "                \n",
    "            end_time = time.perf_counter()\n",
    "            times.append(end_time - start_time)\n",
    "\n",
    "    avg_time_ms = np.mean(times) * 1000  # Konwersja na milisekundy\n",
    "    std_time_ms = np.std(times) * 1000\n",
    "    \n",
    "    print(f\"Średni czas predykcji na batch: {avg_time_ms:.2f} ms ± {std_time_ms:.2f} ms\")\n",
    "    return avg_time_ms"
   ]
  },
  {
   "cell_type": "code",
