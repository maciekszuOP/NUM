   "source": [
    "print(\"--- UNSTRUCTURED PRUNING (Wyzerowanie 30% pojedynczych wag) ---\")\n",
    "model_unstructured = copy.deepcopy(final_model)\n",
    "\n",
    "# Zerujemy 30% najmniejszych wag w warstwach\n",
    "for module in [model_unstructured.conv1, model_unstructured.conv2, model_unstructured.fc1, model_unstructured.fc2]:\n",
    "    prune.l1_unstructured(module, name=\"weight\", amount=0.3)\n",
    "    prune.remove(module, 'weight') # Aplikujemy maskę na stałe\n",
    "\n",
    "unstructured_f1 = evaluate_f1(model_unstructured, val_loader, device=test_device)\n",
    "unstructured_time = measure_inference_time(model_unstructured, val_loader, device=test_device)\n",
    "\n",
    "print(f\"F1 Score (Unstructured): {unstructured_f1:.4f}\")\n",
    "print(f\"Czas predykcji (batch): {unstructured_time:.2f} ms\")\n",
    "\n",
    "\n",
    "print(\"\\n--- STRUCTURED PRUNING (Usunięcie 30% całych filtrów/neuronów) ---\")\n",
    "model_structured = copy.deepcopy(final_model)\n",
    "\n",
    "# Usuwamy całe filtry (dim=0 to kanały wyjściowe w konwolucjach i neurony w FC)\n",
    "prune.ln_structured(model_structured.conv1, name=\"weight\", amount=0.3, n=2, dim=0)\n",
    "prune.remove(model_structured.conv1, 'weight')\n",
    "\n",
    "prune.ln_structured(model_structured.conv2, name=\"weight\", amount=0.3, n=2, dim=0)\n",
    "prune.remove(model_structured.conv2, 'weight')\n",
    "\n",
    "prune.ln_structured(model_structured.fc1, name=\"weight\", amount=0.3, n=2, dim=0)\n",
    "prune.remove(model_structured.fc1, 'weight')\n",
    "\n",
    "structured_f1 = evaluate_f1(model_structured, val_loader, device=test_device)\n",
    "structured_time = measure_inference_time(model_structured, val_loader, device=test_device)\n",
    "\n",
    "print(f\"F1 Score (Structured): {structured_f1:.4f}\")\n",
    "print(f\"Czas predykcji (batch): {structured_time:.2f} ms\")"
   ]
