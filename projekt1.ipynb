   "source": [
    "import time\n",
    "import torch\n",
    "import torch.nn.utils.prune as prune\n",
    "import numpy as np\n",
    "from torchmetrics import F1Score\n",
    "import copy\n",
    "\n",
    "# 1. Funkcja do mierzenia czasu predykcji (zgodnie z instrukcją HW5)\n",
    "def measure_inference_time(model, dataloader, device=\"cpu\", num_warmup=10, num_measurements=100):\n",
    "    model = model.to(device)\n",
    "    model.eval()\n",
    "\n",
    "    # Pobieramy jeden batch danych\n",
    "    dataiter = iter(dataloader)\n",
    "    images, _ = next(dataiter)\n",
    "    images = images.to(device)\n",
    "    \n",
    "    times = []\n",
    "\n",
    "    with torch.no_grad(): # Blokujemy gradienty!\n",
    "        # ROZGRZEWKA\n",
    "        for _ in range(num_warmup):\n",
    "            _ = model(images)\n",
    "            \n",
    "        if device == \"cuda\":\n",
    "            torch.cuda.synchronize()\n",
    "            \n",
    "        # WŁAŚCIWY POMIAR\n",
    "        for _ in range(num_measurements):\n",
    "            start_time = time.perf_counter()\n",
    "            _ = model(images)\n",
    "            if device == \"cuda\":\n",
    "                torch.cuda.synchronize()\n",
    "            end_time = time.perf_counter()\n",
    "            times.append(end_time - start_time)\n",
    "\n",
    "    avg_time_ms = np.mean(times) * 1000\n",
    "    return avg_time_ms\n",
    "\n",
    "# 2. Funkcja do mierzenia F1 Score\n",
    "def evaluate_f1(model, dataloader, device=\"cpu\"):\n",
    "    model = model.to(device)\n",
    "    model.eval()\n",
    "    f1_metric = F1Score(task=\"multiclass\", num_classes=10).to(device)\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for images, labels in dataloader:\n",
    "            images, labels = images.to(device), labels.to(device)\n",
    "            preds = model(images)\n",
    "            f1_metric.update(preds, labels)\n",
    "            \n",
    "    return f1_metric.compute().item()\n",
    "\n",
    "# 3. Przygotowanie danych i pomiar Baseline\n",
    "# UWAGA: Do pomiarów czasu kwantyzacji najlepiej użyć CPU, \n",
    "# bo PyTorch najlepiej optymalizuje kwantyzację int8 właśnie pod procesory.\n",
    "test_device = \"cpu\" \n",
    "final_datamodule.setup()\n",
    "val_loader = final_datamodule.val_dataloader()\n",
    "\n",
    "print(\"--- BASELINE (Float32) ---\")\n",
    "baseline_model = copy.deepcopy(final_model)\n",
    "baseline_f1 = evaluate_f1(baseline_model, val_loader, device=test_device)\n",
    "baseline_time = measure_inference_time(baseline_model, val_loader, device=test_device)\n",
    "\n",
    "print(f\"F1 Score: {baseline_f1:.4f}\")\n",
    "print(f\"Czas predykcji (batch): {baseline_time:.2f} ms\")"
   ]
  },
