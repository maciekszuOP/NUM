     "text": [
      "--- KWANTYZACJA 16-BIT (Float16) ---\n",
      "F1 Score (16-bit): 0.4985\n",
      "Czas predykcji (batch): 1581.82 ms\n",
      "\n",
      "--- KWANTYZACJA 8-BIT (Int8) ---\n",
      "F1 Score (Int8): 0.4983\n",
      "Czas predykcji (batch): 141.68 ms\n"
     ]
    }
   ],
   "source": [
    "print(\"--- KWANTYZACJA 16-BIT (Float16) ---\")\n",
    "# Zamieniamy wagi na 16-bitowe\n",
    "model_16bit = copy.deepcopy(final_model).half()\n",
    "\n",
    "# Musimy też rzutować dane wejściowe na half(), dlatego mierzymy to osobno\n",
    "model_16bit.eval()\n",
    "f1_metric_16 = F1Score(task=\"multiclass\", num_classes=10).to(test_device)\n",
    "times_16 = []\n",
    "\n",
    "with torch.no_grad():\n",
    "    for images, labels in val_loader:\n",
    "        images = images.to(test_device).half() # <-- rzutowanie danych\n",
    "        labels = labels.to(test_device)\n",
    "        preds = model_16bit(images)\n",
    "        f1_metric_16.update(preds, labels)\n",
    "        \n",
    "f1_16bit = f1_metric_16.compute().item()\n",
    "print(f\"F1 Score (16-bit): {f1_16bit:.4f}\")\n",
    "\n",
    "# Pomiar czasu (uproszczony dla half)\n",
    "dataiter = iter(val_loader)\n",
    "images, _ = next(dataiter)\n",
    "images = images.to(test_device).half()\n",
    "with torch.no_grad():\n",
    "    for _ in range(10): _ = model_16bit(images) # warmup\n",
    "    for _ in range(100):\n",
    "        start = time.perf_counter()\n",
    "        _ = model_16bit(images)\n",
    "        times_16.append(time.perf_counter() - start)\n",
    "print(f\"Czas predykcji (batch): {np.mean(times_16)*1000:.2f} ms\")\n",
    "\n",
    "\n",
    "print(\"\\n--- KWANTYZACJA 8-BIT (Int8) ---\")\n",
    "# PyTorch pozwala na łatwą dynamiczną kwantyzację warstw Linear do Int8\n",
    "model_int8 = torch.ao.quantization.quantize_dynamic(\n",
    "    final_model.to('cpu'),  # Kwantyzacja dynamiczna działa najlepiej na CPU\n",
    "    {torch.nn.Linear}, \n",
    "    dtype=torch.qint8\n",
    ")\n",
    "\n",
    "int8_f1 = evaluate_f1(model_int8, val_loader, device=\"cpu\")\n",
    "int8_time = measure_inference_time(model_int8, val_loader, device=\"cpu\")\n",
    "\n",
    "print(f\"F1 Score (Int8): {int8_f1:.4f}\")\n",
    "print(f\"Czas predykcji (batch): {int8_time:.2f} ms\")"
   ]
  },
